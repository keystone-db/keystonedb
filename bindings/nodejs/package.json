{
  "name": "keystonedb",
  "version": "0.1.0",
  "description": "Node.js bindings for KeystoneDB - a DynamoDB-compatible embedded database",
  "main": "index.js",
  "types": "index.d.ts",
  "napi": {
    "name": "keystonedb",
    "triples": {
      "defaults": true,
      "additional": [
        "x86_64-unknown-linux-gnu",
        "aarch64-unknown-linux-gnu",
        "x86_64-apple-darwin",
        "aarch64-apple-darwin",
        "x86_64-pc-windows-msvc"
      ]
    }
  },
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/keystone-db/keystonedb"
  },
  "keywords": [
    "database",
    "dynamodb",
    "key-value",
    "embedded",
    "nosql",
    "rust",
    "napi-rs"
  ],
  "files": [
    "index.js",
    "index.d.ts"
  ],
  "devDependencies": {
    "@napi-rs/cli": "^2.18.0",
    "@types/node": "^20.0.0",
    "mocha": "^10.2.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">= 14"
  },
  "scripts": {
    "artifacts": "napi artifacts",
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform",
    "prepublishOnly": "napi prepublish -t npm",
    "version": "napi version",
    "test": "mocha test/test.js",
    "test:standalone": "node test/test.js"
  }
}
